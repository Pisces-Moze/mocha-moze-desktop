+/* The per-fence BO is referenced read/write by the submitted pushbuffer.
+ * Export its dma_resv fence after submission, without waiting on the CPU.
+ * Do not export the shared query BO, which can include unrelated later work.
+ */
+static int
+nouveau_bo_export_sync_file(struct nouveau_bo *bo)
+{
+   int dmabuf = -1;
+   if (nouveau_bo_set_prime(bo, &dmabuf))
+      return -1;
+   struct dma_buf_export_sync_file export = {
+      .flags = DMA_BUF_SYNC_RW,
+      .fd = -1,
+   };
+   int ret = drmIoctl(dmabuf, DMA_BUF_IOCTL_EXPORT_SYNC_FILE, &export);
+   close(dmabuf);
+   return ret ? -1 : export.fd;
+}
+
+bool
+nouveau_native_sync_supported(struct nouveau_screen *screen)
+{
+   /* Opt-in until both standalone and compositor tests pass on GK20A. */
+   const char *enable = getenv("MOCHA_NATIVE_FENCE");
+   if (screen->device->chipset != 0xea || !enable || strcmp(enable, "1"))
+      return false;
+   struct nouveau_bo *bo = NULL;
+   if (nouveau_bo_new(screen->device, NOUVEAU_BO_GART, 4096, 4096, NULL, &bo))
+      return false;
+   int fd = nouveau_bo_export_sync_file(bo);
+   nouveau_bo_ref(NULL, &bo);
+   if (fd < 0)
+      return false;
+   close(fd);
+   return true;
+}
+
+int
+nouveau_fence_get_fd(struct pipe_screen *pscreen,
+                     struct pipe_fence_handle *pfence)
+{
+   struct nouveau_fence *fence = nouveau_fence(pfence);
+   if (!fence)
+      return -1;
+   if (fence->sync_fd >= 0)
+      return os_dupfd_cloexec(fence->sync_fd);
+   simple_mtx_lock(&fence->screen->fence.lock);
+   int fd = nouveau_fence_kick(fence) ? nouveau_bo_export_sync_file(fence->bo) : -1;
+   simple_mtx_unlock(&fence->screen->fence.lock);
+   return fd;
+}
+
+void
+nouveau_create_fence_fd(struct pipe_context *pipe,
+                        struct pipe_fence_handle **pfence,
+                        int fd, enum pipe_fd_type type)
+{
+   *pfence = NULL;
+   if (type != PIPE_FD_TYPE_NATIVE_SYNC)
+      return;
+   struct nouveau_fence *fence = CALLOC_STRUCT(nouveau_fence);
+   if (!fence)
+      return;
+   fence->sync_fd = os_dupfd_cloexec(fd);
+   if (fence->sync_fd < 0) {
+      FREE(fence);
+      return;
+   }
+   fence->screen = nouveau_context(pipe)->screen;
+   fence->ref = 1;
+   list_inithead(&fence->work);
+   *pfence = (struct pipe_fence_handle *)fence;
+}
+
+void
+nouveau_fence_server_sync(struct pipe_context *pipe,
+                          struct pipe_fence_handle *pfence)
+{
+   /* External input dependencies retain a real wait. Output fences are
+    * exported asynchronously for the KMS IN_FENCE_FD path above. */
+   if (pfence && !nouveau_fence_wait(nouveau_fence(pfence), NULL))
+      debug_printf("nouveau: failed to wait for an imported native fence\n");
+}
