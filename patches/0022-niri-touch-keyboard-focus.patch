+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Non-focusable tablet input surfaces do not dismiss an OnDemand layer's focus.
+pub(crate) fn preserve_on_demand(namespace: &str, no_keyboard_focus: bool) -> bool {
+    no_keyboard_focus
+        && matches!(namespace, "mocha-touch-keyboard" | "mocha-pinyin-candidates")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::preserve_on_demand;
+    #[test]
+    fn keyboard_and_candidates_keep_the_text_field_focused() {
+        assert!(preserve_on_demand("mocha-touch-keyboard", true));
+        assert!(preserve_on_demand("mocha-pinyin-candidates", true));
+    }
+    #[test]
+    fn other_clicks_keep_existing_focus_policy() {
+        for name in ["noctalia-bar-bar", "noctalia-panel-click-shield", "", "other-app"] {
+            assert!(!preserve_on_demand(name, true));
+        }
+    }
+    #[test]
+    fn focusable_surface_cannot_claim_the_keyboard_exception() {
+        assert!(!preserve_on_demand("mocha-touch-keyboard", false));
+    }
+}
