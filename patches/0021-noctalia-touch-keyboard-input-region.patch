-void PanelClickShield::initialize(WaylandConnection& wayland) { m_wayland = &wayland; }
+void PanelClickShield::initialize(WaylandConnection& wayland, FileWatcher* files) {
+  m_wayland = &wayland;
+  m_files = files;
+  if (const char* runtime = std::getenv("XDG_RUNTIME_DIR"); runtime && runtime[0]) {
+    m_keyboardPath = std::filesystem::path(runtime) / "mocha-keyboard-visible.json";
+    if (m_files) m_keyboardWatch = m_files->watch(m_keyboardPath, [this] {
+      reloadTouchKeyboard();
+      // FileWatcher coalesces rapid writes. Read the final show/hide/resize
+      // state once after that interval, without a continuous file poll.
+      m_keyboardReloadTimer.start(std::chrono::milliseconds(110), [this] { reloadTouchKeyboard(); });
+    }, FileWatcher::WatchTrigger::WriteCompleted);
+  }
+}
+
+void PanelClickShield::refreshInputRegions() {
+  for (auto& [output, shield] : m_shields) {
+    if (shield && shield->configured) {
+      applyInputRegion(*shield);
+      wl_surface_commit(shield->surface);
+    }
+  }
+}
+
+void PanelClickShield::reloadTouchKeyboard() {
+  m_keyboard.reset();
+  if (!m_keyboardPath.empty()) {
+    std::ifstream file(m_keyboardPath);
+    std::array<char, 4097> data{};
+    file.read(data.data(), data.size());
+    const auto n = file.gcount();
+    if (n > 0 && n <= 4096) {
+      auto j = nlohmann::json::parse(data.data(), data.data()+n, nullptr, false);
+      m_keyboard = touch_keyboard::parse(j);
+      if (m_keyboard && kill(m_keyboard->pid, 0) != 0) m_keyboard.reset();
+    }
+  }
+  refreshInputRegions();
+  m_keyboardLivenessTimer.stop();
+  if (m_keyboard && !m_shields.empty()) {
+    m_keyboardLivenessTimer.startRepeating(std::chrono::seconds(1), [this] {
+      if (m_keyboard && kill(m_keyboard->pid, 0) != 0) {
+        m_keyboard.reset();
+        refreshInputRegions();
+        m_keyboardLivenessTimer.stop();
+      }
+    });
+  }
+}
 
