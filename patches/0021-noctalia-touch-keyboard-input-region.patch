@@ -0,0 +1,44 @@
+#pragma once
+#include <array>
+#include <optional>
+#include <vector>
+#include <nlohmann/json.hpp>
+
+namespace touch_keyboard {
+struct State {
+  int pid = 0;
+  int x = 0, y = 0, width = 0, height = 0;
+  std::vector<std::array<int, 3>> rects; // width, height, bottom margin
+};
+
+inline std::optional<State> parse(const nlohmann::json& j) {
+  try {
+    if (!j.is_object() || !j.value("visible", false)) return std::nullopt;
+    State s;
+    s.pid = j.at("pid").get<int>();
+    const auto& m = j.at("monitor");
+    s.x = m.at("x").get<int>(); s.y = m.at("y").get<int>();
+    s.width = m.at("width").get<int>(); s.height = m.at("height").get<int>();
+    if (s.pid <= 0 || s.width <= 0 || s.height <= 0 || s.width > 32768 || s.height > 32768)
+      return std::nullopt;
+    const auto& rects = j.at("rects");
+    if (!rects.is_array() || rects.empty() || rects.size() > 4) return std::nullopt;
+    for (const auto& r : rects) {
+      const int w = r.at("width").get<int>(), h = r.at("height").get<int>(), b = r.at("bottom").get<int>();
+      if (w <= 0 || h <= 0 || w > s.width || h > s.height || b < 0 || b > s.height - h)
+        return std::nullopt;
+      s.rects.push_back({w, h, b});
+    }
+    return s;
+  } catch (const nlohmann::json::exception&) { return std::nullopt; }
+}
+
+inline std::vector<std::array<int, 4>> rectangles(
+    const State& s, int x, int y, int width, int height, int surfaceWidth, int surfaceHeight) {
+  if (s.x != x || s.y != y || s.width != width || s.height != height
+      || surfaceWidth != width || surfaceHeight != height) return {};
+  std::vector<std::array<int, 4>> result;
+  for (const auto& r : s.rects) result.push_back({(width-r[0])/2, height-r[2]-r[1], r[0], r[1]});
+  return result;
+}
+} // namespace touch_keyboard
