+-- Severe pressure policy stays inside the existing 1 Hz service. No process
+-- scan, shell command or extra polling daemon runs in the healthy steady state.
+local function pressureNumber(key, default, minimum, maximum)
+  local value = cfg(key)
+  if type(value) ~= "number" then value = default end
+  return math.max(minimum, math.min(maximum, value))
+end
+
+local function psi(path, kind)
+  local text = noctalia.readFile(path)
+  if type(text) ~= "string" then return nil end
+  return tonumber(text:match(kind .. "%s+avg10=([%d%.]+)"))
+end
+
+local function releaseUnderPressure(connector, path)
+  local generation = nextGeneration(connector)
+  local released = { path = path, wasPaused = isPaused[connector] == true }
+  pressureReleased[connector] = released
+  local function finish(result)
+    if not pressureActive or not currentSelection(connector, path, generation) then return end
+    if result and type(result.stdout) == "string" then
+      local value = tonumber(result.stdout:match('"data"%s*:%s*([%d%.]+)'))
+      if value and value >= 0 and value < 2678400 then released.position = value end
+    end
+    killMpvpaper(connector, function(result)
+      if not currentSelection(connector, path, generation) then return end
+      if type(result) ~= "table" or result.exitCode ~= 0 then
+        pressureReleased[connector] = nil
+        noctalia.log("mpvpaper: pressure release did not finish; will retry")
+        return
+      end
+      forEachOutput(connector, function(name) noctalia.setWallpaperEnabled(name, true) end)
+      publish()
+    end)
+  end
+  if noctalia.fileExists(ipcSocketPath(connector)) and noctalia.commandExists("socat") then
+    local query = '{"command":["get_property","time-pos"]}'
+    noctalia.runAsync("printf '%s\n' " .. shellQuote(query) .. " | socat -t 0.3 - " ..
+      shellQuote("UNIX-CONNECT:" .. ipcSocketPath(connector)), finish)
+  else
+    finish(nil)
+  end
+end
+
+local function updateResourcePressure()
+  local wasActive = pressureActive
+  local now = noctalia.nowMs() / 1000
+  local enabled = cfg("pause_on_pressure") == true
+  local info = noctalia.readFile("/proc/meminfo")
+  local available = type(info) == "string" and tonumber(info:match("MemAvailable:%s+(%d+)")) or nil
+  if available then available = available / 1024 end
+  local low = pressureNumber("pressure_low_mib", 128, 32, 2048)
+  local high = math.max(low + 64, pressureNumber("pressure_resume_mib", 256, 96, 4096))
+  local memory = psi("/proc/pressure/memory", "full")
+  local cpu = psi("/proc/pressure/cpu", "some")
+  local bad = enabled and available and
+    (available < low or (memory and memory >= 5 and available < high) or
+      (cfg("pause_on_cpu_pressure") == true and cpu and cpu >= 85))
+  local reason = available and available < low and "memory" or
+    (memory and memory >= 5 and "memory-stall" or "cpu-stall")
+  local recovered = available and available >= high and
+      (not memory or memory < 1) and (not cpu or cpu < 25)
+  if bad then
+    pressureBadSince = pressureBadSince or now
+    pressureGoodSince = nil
+    local hold = pressureNumber("pressure_hold_seconds", 3, 1, 60)
+    if available < 64 or now - pressureBadSince >= hold then
+      pressureActive = true
+      pressureReason = reason
+    end
+  else
+    pressureBadSince = nil
+    if not enabled then
+      pressureGoodSince = now - 3600
+    elseif recovered then
+      pressureGoodSince = pressureGoodSince or now
+    else
+      pressureGoodSince = nil
+    end
+    local delay = pressureNumber("pressure_recovery_seconds", 15, 3, 300)
+    if pressureActive and pressureGoodSince and now - pressureGoodSince >= delay then
+      pressureActive = false
+      pressureReason = nil
+      for connector, released in pairs(pressureReleased) do
+        pressureReleased[connector] = nil
+        if assignments[connector] == released.path then
+          resumePositions[connector] = released
+          startMpvpaper(connector, released.path)
+        end
+      end
+      publish()
+    end
+  end
+  if pressureActive then
+    for connector, path in pairs(assignments) do
+      if not pressureReleased[connector] or pressureReleased[connector].path ~= path then
+        releaseUnderPressure(connector, path)
+      end
+    end
+  end
+  if wasActive ~= pressureActive then publish() end
+end
+
