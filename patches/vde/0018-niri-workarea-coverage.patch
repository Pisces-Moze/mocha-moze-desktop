+    /// Settled active-workspace coverage, ignoring small configured tile gaps.
+    pub fn wallpaper_workarea_covered(&self, output: &Output) -> bool {
+        if self.interactive_move.is_some() || self.is_overview_open() { return false; }
+        let Some(mon) = self.monitor_for_output(output) else { return false; };
+        if mon.workspace_switch.is_some() { return false; }
+        let ws = mon.active_workspace_ref();
+        if ws.windows().next().is_none() { return false; }
+        let a = ws.working_area();
+        let rects = ws.tiles_with_render_positions().filter_map(|(tile, pos, visible)| {
+            if !visible { return None; }
+            let size = tile.tile_size();
+            Some([pos.x, pos.y, size.w, size.h])
+        });
+        crate::workspace_coverage::covers([a.loc.x, a.loc.y, a.size.w, a.size.h], rects,
+            ws.options.layout.gaps)
+    }
