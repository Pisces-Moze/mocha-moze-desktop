+/* Restricted processes may be unable to traverse libudev's sysfs paths.
+ * Fall back to absolute device nodes and the kernel's media topology. The
+ * caller's access policy still decides which nodes can actually be opened. */
+static int v4l2request_probe_media_nodes(AVHWFramesContext *hwfc,
+                                      uint32_t pixelformat, uint32_t buffersize)
+{
+    AVV4L2RequestFramesContext *fctx = hwfc->hwctx;
+    AVV4L2RequestFramesContextInternal *fctxi = fctx->internal;
+    struct dirent *entry;
+    DIR *dir = opendir("/dev");
+    int ret = AVERROR(ENOENT);
+    if (!dir)
+        return AVERROR(errno);
+    while ((entry = readdir(dir))) {
+        char path[sizeof("/dev/") + sizeof(entry->d_name)];
+        struct stat before, after;
+        if (!v4l2request_node_name(entry->d_name, "media"))
+            continue;
+        snprintf(path, sizeof(path), "/dev/%s", entry->d_name);
+        if (lstat(path, &before) < 0 || !S_ISCHR(before.st_mode))
+            continue;
+        fctxi->media_fd = open(path, O_RDWR | O_CLOEXEC | O_NOFOLLOW);
+        if (fctxi->media_fd < 0)
+            continue;
+        if (fstat(fctxi->media_fd, &after) < 0) {
+            ret = AVERROR(errno);
+        } else if (!S_ISCHR(after.st_mode) || before.st_rdev != after.st_rdev) {
+            ret = AVERROR(ENODEV);
+        } else {
+            ret = v4l2request_probe_video_devices(hwfc, NULL, pixelformat, buffersize);
+        }
+        if (!ret) {
+            av_log(hwfc, AV_LOG_INFO, "V4L2 Request absolute-node enumeration selected %s\n", path);
+            break;
+        }
+        close(fctxi->media_fd);
+        fctxi->media_fd = -1;
+    }
+    closedir(dir);
+    return ret;
+}
