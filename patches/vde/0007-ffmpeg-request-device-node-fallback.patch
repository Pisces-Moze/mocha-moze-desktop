+/* Only native numeric device names; no aliases or symlink traversal. */
+static int v4l2request_node_name(const char *name, const char *prefix)
+{
+    size_t len = strlen(prefix);
+    if (strncmp(name, prefix, len) || !name[len])
+        return 0;
+    for (name += len; *name; name++)
+        if (*name < '0' || *name > '9')
+            return 0;
+    return 1;
+}
+
+static int v4l2request_probe_video_devnum(AVHWFramesContext *hwfc, dev_t devnum,
+                                       uint32_t pixelformat, uint32_t buffersize)
+{
+    struct dirent *entry;
+    DIR *dir = opendir("/dev");
+    int ret = AVERROR(ENOENT);
+    if (!dir)
+        return AVERROR(errno);
+    while ((entry = readdir(dir))) {
+        char path[sizeof("/dev/") + sizeof(entry->d_name)];
+        struct stat st;
+        if (!v4l2request_node_name(entry->d_name, "video"))
+            continue;
+        snprintf(path, sizeof(path), "/dev/%s", entry->d_name);
+        if (lstat(path, &st) < 0 || !S_ISCHR(st.st_mode) || st.st_rdev != devnum)
+            continue;
+        ret = v4l2request_probe_video_device(hwfc, path, devnum, pixelformat, buffersize);
+        if (!ret)
+            break;
+    }
+    closedir(dir);
+    return ret;
+}
