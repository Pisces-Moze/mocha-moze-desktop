+-- The compositor publishes transitions after its X-Ray-aware visibility pass.
+-- Unknown/stale sessions fail open. No geometric guesses, shell commands or
+-- additional polling processes are needed for this policy.
+local function updateCoverage(now)
+  local socket = noctalia.getenv("NIRI_SOCKET") or ""
+  local pid = socket:match("%.(%d+)%.sock$")
+  local runtime = noctalia.getenv("XDG_RUNTIME_DIR")
+  local enabled = cfg("release_when_covered") == true and pid and runtime and
+    (noctalia.readFile("/proc/" .. pid .. "/comm") or ""):match("^niri%s*$")
+  local function hidden(name)
+    if not enabled then return false end
+    local encoded = name:gsub(".", function(c) return string.format("%02x", c:byte()) end)
+    local text = noctalia.readFile(runtime .. "/mocha-niri-background-" .. pid .. "-" .. encoded .. ".json")
+    if type(text) ~= "string" then return false end
+    local ok, data = pcall(noctalia.json.decode, text)
+    return ok and type(data) == "table" and data.schema == 1 and data.pid == tonumber(pid) and
+      data.output == name and data.visible == false and data.overview ~= true and data.shell_overlay ~= true
+  end
+  local changed = false
+  for connector in pairs(assignments) do
+    local allHidden = enabled and true or false
+    if connector == "*" then
+      local outputs = noctalia.outputs()
+      allHidden = allHidden and #outputs > 0
+      for _, output in ipairs(outputs) do
+        if not hidden(output.name) then allHidden = false; break end
+      end
+    else
+      allHidden = allHidden and hidden(connector)
+    end
+    if allHidden then
+      coverBadSince[connector] = coverBadSince[connector] or now
+      if now - coverBadSince[connector] >= pressureNumber("covered_hold_seconds", 2, 1, 30) then
+        if not covered[connector] then changed = true end
+        covered[connector] = true
+      end
+    else
+      coverBadSince[connector] = nil
+      if covered[connector] then changed = true end
+      covered[connector] = nil
+    end
+  end
+  if changed then publish() end
+end
