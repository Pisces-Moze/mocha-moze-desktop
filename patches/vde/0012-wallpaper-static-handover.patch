+-- Apply a static selection as one transaction. A stale frame extraction or
+-- delayed video launch must never overwrite this newer selection.
+local function setStatic(path)
+  if type(path) ~= "string" or path == "" or not noctalia.fileExists(path) then return end
+  staticRequest = staticRequest + 1
+  local request = staticRequest
+  -- This is an explicit user choice, unlike the lock hook's clear-all.
+  -- Reapply after an unlock must not resurrect an older video selection.
+  lastAssignments = {}
+  local connectors = {}
+  for conn in pairs(assignments) do connectors[conn] = true end
+  for conn in pairs(generations) do connectors[conn] = true end
+  if next(connectors) == nil then connectors["*"] = true end
+  assignments = {}
+  staticSelection = nil
+  persist()
+  publish()
+  local remaining = 0
+  for conn in pairs(connectors) do
+    nextGeneration(conn)
+    remaining = remaining + 1
+  end
+  local failed = false
+  for conn in pairs(connectors) do
+    killMpvpaper(conn, function(result)
+      if staticRequest ~= request then return end
+      if type(result) ~= "table" or result.exitCode ~= 0 then failed = true end
+      remaining = remaining - 1
+      if remaining ~= 0 then return end
+      if failed then
+        noctalia.log("mpvpaper: static handover cancelled because a player is still running")
+        return
+      end
+      for _, output in ipairs(noctalia.outputs()) do
+        noctalia.setWallpaper(output.name, path)
+        noctalia.setWallpaperEnabled(output.name, true)
+      end
+      staticSelection = path
+      persist()
+      publish()
+    end)
+  end
 end
 
