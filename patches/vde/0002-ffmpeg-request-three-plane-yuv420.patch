+            if (!plane->bytesperline ||
+                (uint64_t)plane->bytesperline * rows > plane->sizeimage)
+                return AVERROR(EINVAL);
+            layer->planes[i].object_index = object;
+            layer->planes[i].offset = 0;
+            layer->planes[i].pitch = plane->bytesperline;
+        }
