 const static struct wl_callback_listener wl_surface_frame_listener;
 
+/* Layer-shell dimensions are logical. Do not round a 1.5 scale up to
+ * a 2x framebuffer and then make the compositor downsample it again.
+ * Buffer scale remains one when wp_viewport maps fractional pixel sizes.
+ */
+static void update_output_size(struct display_output *output) {
+    if (!output->surface || !output->width || !output->height)
+        return;
+    uint64_t scale = output->fractional_scale ? output->preferred_scale : output->scale * 120u;
+    uint64_t width = ((uint64_t)output->width * scale + 60u) / 120u;
+    uint64_t height = ((uint64_t)output->height * scale + 60u) / 120u;
+    if (!width || !height || width > INT_MAX || height > INT_MAX ||
+            output->width > INT_MAX || output->height > INT_MAX) {
+        cflp_error("Invalid scaled wallpaper dimensions");
+        exit_mpvpaper(EXIT_FAILURE);
+    }
+    output->buffer_width = width;
+    output->buffer_height = height;
+    if (output->viewport) {
+        wl_surface_set_buffer_scale(output->surface, 1);
+        wp_viewport_set_destination(output->viewport, output->width, output->height);
+    } else {
+        wl_surface_set_buffer_scale(output->surface, output->scale);
+    }
+    if (output->egl_window)
+        wl_egl_window_resize(output->egl_window, width, height, 0, 0);
+    output->redraw_needed = true;
+    if (VERBOSE)
+        cflp_info("Output %s framebuffer %ux%u logical %ux%u scale %u/120",
+                  output->name, output->buffer_width, output->buffer_height,
+                  output->width, output->height, (uint)scale);
+}
+
+static void preferred_scale(void *data, struct wp_fractional_scale_v1 *object, uint32_t scale) {
+    (void)object;
+    struct display_output *output = data;
+    if (!scale || scale > 120u * 16u) return;
+    output->preferred_scale = scale;
+    update_output_size(output);
+}
+
+static const struct wp_fractional_scale_v1_listener fractional_listener = {
+    .preferred_scale = preferred_scale,
+};
+
