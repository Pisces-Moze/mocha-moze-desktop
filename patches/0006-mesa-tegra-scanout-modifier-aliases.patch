+/* Tegra K1 KMS uses the original block-linear modifier spelling. The
+ * generalized spelling with generic kind 0xfe is the same memory layout;
+ * drm_fourcc_canonicalize_nvidia_format_mod() documents this equivalence.
+ * Preserve every other kind, generation, sector and compression layout.
+ */
+static uint64_t
+tegra_screen_scanout_modifier(uint64_t modifier)
+{
+   for (unsigned h = 0; h <= 5; h++) {
+      if (modifier == DRM_FORMAT_MOD_NVIDIA_BLOCK_LINEAR_2D(0, 0, 0, 0xfe, h))
+         return DRM_FORMAT_MOD_NVIDIA_16BX2_BLOCK(h);
+   }
+
+   return modifier;
+}
+
+static uint64_t
+tegra_screen_gpu_modifier(uint64_t modifier)
+{
+   for (unsigned h = 0; h <= 5; h++) {
+      if (modifier == DRM_FORMAT_MOD_NVIDIA_16BX2_BLOCK(h))
+         return DRM_FORMAT_MOD_NVIDIA_BLOCK_LINEAR_2D(0, 0, 0, 0xfe, h);
+   }
+
+   return modifier;
+}
+
