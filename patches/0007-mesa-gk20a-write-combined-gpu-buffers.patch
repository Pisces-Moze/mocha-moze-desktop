@@ -40,6 +40,22 @@
 #include "nvc0/mme/comc597.mme.h"
 
 #include "nv50/g80_texture.xml.h"
+
+/* GPU-private heaps have no cached CPU readback users. On non-coherent
+ * GK20A, the coherent BO interface selects write-combined CPU mappings,
+ * avoiding whole-heap cache maintenance at every command submission.
+ */
+static uint32_t
+nvc0_screen_heap_flags(struct nvc0_screen *screen)
+{
+   uint32_t flags = NV_VRAM_DOMAIN(&screen->base);
+
+   if (screen->base.device->chipset == 0xea &&
+       (flags & NOUVEAU_BO_GART) && screen->base.drm->version >= 0x01000202)
+      flags |= NOUVEAU_BO_COHERENT;
+
+   return flags;
+}
 
