+static void AddV4l2RequestDependencies(SandboxBroker::Policy* policy) {
+  if (!Preferences::GetBool("media.ffmpeg.v4l2-request.enabled", false)) {
+    return;
+  }
+  DIR* dir = opendir("/dev");
+  if (!dir) {
+    return;
+  }
+  while (auto entry = readdir(dir)) {
+    if (strncmp(entry->d_name, "media", 5)) {
+      continue;
+    }
+    nsPrintfCString path("/dev/%s", entry->d_name);
+    int fd = open(path.get(), O_RDWR | O_NONBLOCK | O_CLOEXEC);
+    if (fd < 0) {
+      continue;
+    }
+    struct media_device_info info = {};
+    const bool isVDE = !ioctl(fd, MEDIA_IOC_DEVICE_INFO, &info) &&
+        !strncmp(info.model, "tegra-vde", sizeof(info.model)) &&
+        !strncmp(info.bus_info, "platform:tegra-vde", sizeof(info.bus_info));
+    struct stat sb;
+    if (isVDE && !fstat(fd, &sb) && S_ISCHR(sb.st_mode)) {
+      policy->AddPath(rdwr, path.get());
+      // libudev resolves media/video nodes through sysfs. Allow only this
+      // verified VDE device tree; do not grant arbitrary camera media nodes.
+      nsPrintfCString sysPath("/sys/dev/char/%u:%u", major(sb.st_rdev),
+                              minor(sb.st_rdev));
+      UniqueFreePtr<char[]> realSysPath(realpath(sysPath.get(), nullptr));
+      if (realSysPath) {
+        nsCString devicePath(realSysPath.get());
+        const int32_t mediaDir = devicePath.RFind("/media");
+        if (mediaDir > 0) {
+          devicePath.Truncate(mediaDir);
+          if (StringEndsWith(devicePath, "/media"_ns)) {
+            devicePath.Truncate(devicePath.Length() - 6);
+          }
+          policy->AddTree(rdonly, devicePath.get());
+          policy->AddAncestors(devicePath.get(), access);
+        }
+      }
+    }
+    close(fd);
+  }
+  closedir(dir);
+  // Enumeration directories and udev metadata, never device read/write.
+  policy->AddPath(rdonly, "/sys/subsystem");
+  policy->AddPath(rdonly, "/sys/bus");
+  policy->AddTree(rdonly, "/sys/bus/media");
+  policy->AddPath(rdonly, "/sys/class");
+  policy->AddPath(rdonly, "/sys/class/media");
+  policy->AddPath(rdonly, "/sys/class/video4linux");
+  policy->AddPath(rdonly, "/sys/dev/char");
+}
+
 static void AddV4l2Dependencies(SandboxBroker::Policy* policy) {
+  AddV4l2RequestDependencies(policy);
   // For V4L2 hardware-accelerated video decode, RDD needs access to certain
   // /dev/video* devices but don't want to allow it access to webcams etc.
   // So we only allow it access to M2M video devices (encoders and decoders).
