+/* static */ bool FFmpegVideoDecoder<LIBAV_VER>::SupportsV4L2RequestConfig(
+    const VideoInfo& aInfo) {
+#if defined(MOZ_WIDGET_GTK) && defined(MOZ_ENABLE_V4L2) && \
+    LIBAVCODEC_VERSION_MAJOR >= 58 && !defined(FFVPX_VERSION)
+  if (!StaticPrefs::media_ffmpeg_v4l2_request_enabled() ||
+      !StaticPrefs::media_hardware_video_decoding_enabled_AtStartup() ||
+      GetCodecId(aInfo.mMimeType) != AV_CODEC_ID_H264) {
+    return false;
+  }
+  SPSData sps;
+  // Initial hardware scope: progressive constrained Baseline, 8-bit 4:2:0.
+  // VDE does not implement CABAC. Do not advertise Main/High as accelerated
+  // or feed unsupported 8x8 transforms to it. Missing SPS means SW fallback.
+  return H264::DecodeSPSFromExtraData(aInfo.mExtraData, sps) && sps.valid &&
+         sps.profile_idc == H264_PROFILE_BASE && sps.constraint_set1_flag &&
+         sps.chroma_format_idc == 1 && !sps.bit_depth_luma_minus8 &&
+         !sps.bit_depth_chroma_minus8 && sps.frame_mbs_only_flag &&
+         !sps.crop_left && !sps.crop_top && sps.pic_width_in_mbs > 0 &&
+         sps.pic_width_in_mbs <= 128 && sps.pic_height_in_map_units > 0 &&
+         sps.pic_height_in_map_units <= 128 && sps.max_num_ref_frames <= 16;
+#else
+  return false;
+#endif
+}
