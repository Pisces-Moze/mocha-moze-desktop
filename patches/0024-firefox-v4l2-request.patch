+MediaResult FFmpegVideoDecoder<LIBAV_VER>::InitV4L2RequestDecoder() {
+#if defined(MOZ_ENABLE_V4L2) && LIBAVCODEC_VERSION_MAJOR >= 58 && \
+    !defined(FFVPX_VERSION)
+  if (!SupportsV4L2RequestConfig(mInfo)) {
+    return NS_ERROR_NOT_AVAILABLE;
+  }
+  AVHWDeviceType deviceType = AV_HWDEVICE_TYPE_NONE;
+  AVCodec* codec = FindV4L2RequestAVCodec(mLib, mCodecID, &deviceType);
+  if (!codec) {
+    return NS_ERROR_NOT_AVAILABLE;
+  }
+  StaticMutexAutoLock mon(sMutex);
+  if (!(mCodecContext = mLib->avcodec_alloc_context3(codec))) {
+    return NS_ERROR_OUT_OF_MEMORY;
+  }
+  mCodecContext->opaque = this;
+  InitHWCodecContext(ContextType::V4L2);
+  mCodecContext->apply_cropping = 0;
+  auto releaseDecoder = MakeScopeExit(
+      [&]() MOZ_NO_THREAD_SAFETY_ANALYSIS { ReleaseCodecContext(); });
+  MediaResult rv = AllocateExtraData();
+  if (NS_FAILED(rv)) {
+    return rv;
+  }
+  if (mLib->av_hwdevice_ctx_create(&mCodecContext->hw_device_ctx, deviceType,
+                                  nullptr, nullptr, 0) < 0 ||
+      mLib->avcodec_open2(mCodecContext, codec, nullptr) < 0) {
+    FFMPEG_LOG("V4L2 Request initialization failed; retaining SW fallback");
+    return NS_ERROR_NOT_AVAILABLE;
+  }
+  AdjustHWDecodeLogging();
+  mUsingV4L2 = mUsingV4L2Request = true;
+  releaseDecoder.release();
+  FFMPEG_LOG("V4L2 Request codec opened (DRM PRIME output required)");
+  return NS_OK;
+#else
+  return NS_ERROR_NOT_AVAILABLE;
+#endif
+}
