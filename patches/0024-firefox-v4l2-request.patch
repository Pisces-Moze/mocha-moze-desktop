+/* static */ AVCodec* FFmpegVideoDecoder<LIBAV_VER>::FindV4L2RequestAVCodec(
+    const FFmpegLibWrapper* aLib, AVCodecID aCodec,
+    AVHWDeviceType* aDeviceType) {
+#if defined(MOZ_WIDGET_GTK) && defined(MOZ_ENABLE_V4L2) && \
+    LIBAVCODEC_VERSION_MAJOR >= 58 && !defined(FFVPX_VERSION)
+  if (!StaticPrefs::media_ffmpeg_v4l2_request_enabled() ||
+      !StaticPrefs::media_hardware_video_decoding_enabled_AtStartup() ||
+      aCodec != AV_CODEC_ID_H264 || !aLib->avcodec_get_hw_config ||
+      !aLib->av_hwdevice_get_type_name || !aLib->av_hwdevice_ctx_create) {
+    return nullptr;
+  }
+  AVCodec* codec = aLib->avcodec_find_decoder(aCodec);
+  if (!codec) {
+    return nullptr;
+  }
+  for (int i = 0;; ++i) {
+    const AVCodecHWConfig* config = aLib->avcodec_get_hw_config(codec, i);
+    if (!config) {
+      break;
+    }
+    const char* name = aLib->av_hwdevice_get_type_name(config->device_type);
+    if (config->pix_fmt == AV_PIX_FMT_DRM_PRIME &&
+        (config->methods & AV_CODEC_HW_CONFIG_METHOD_HW_DEVICE_CTX) && name &&
+        !strcmp(name, "v4l2request")) {
+      if (aDeviceType) {
+        *aDeviceType = config->device_type;
+      }
+      return codec;
+    }
+  }
+#endif
+  return nullptr;
+}
