+// Mocha opt-in touch keyboard; no password text is emitted to IPC or logs.
+void LockSurface::buildTouchKeyboard() {
+  const char* enabled = std::getenv("MOCHA_TOUCH_LOCK_KEYBOARD");
+  if (enabled == nullptr || std::string_view(enabled) != "1") {
+    return;
+  }
+  m_root.addChild(ui::flex(FlexDirection::Vertical, {
+      .out = &m_touchKeyboard, .align = FlexAlign::Stretch,
+      .justify = FlexJustify::Start, .gap = 8.0F,
+      .widthPolicy = FlexSizePolicy::Fill, .heightPolicy = FlexSizePolicy::Fill,
+  }));
+  m_touchKeyboard->setZIndex(20);
+  for (int rowIndex = 0; rowIndex < 5; ++rowIndex) {
+    Flex* row = nullptr;
+    m_touchKeyboard->addChild(ui::flex(FlexDirection::Horizontal, {
+        .out = &row, .align = FlexAlign::Stretch,
+        .justify = FlexJustify::Start, .gap = 6.0F,
+        .widthPolicy = FlexSizePolicy::Fill, .heightPolicy = FlexSizePolicy::Content,
+    }));
+    row->setMinHeight(44.0F);
+    row->setMaxHeight(44.0F);
+    const int count = rowIndex == 4 ? 5 : 10;
+    for (int index = 0; index < count; ++index) {
+      Button* button = nullptr;
+      row->addChild(ui::button({
+          .out = &button, .text = "", .fontSize = 22.0F,
+          .variant = ButtonVariant::Secondary,
+          .onClick = [this, rowIndex, index]() {
+            if (m_authenticating) return;
+            const std::array<std::string, 4> letters = {
+                "1234567890", "qwertyuiop", "asdfghjkl;", "zxcvbnm,./"};
+            const std::array<std::string, 4> symbols = {
+                "!@#$%^&*()", "_+-=[]{}\\|", ":;\"'<>,.?/", "`~12345678"};
+            const std::array<std::string, 5> controls = {"Shift", "#+=", "Space", "Backspace", "Enter"};
+            if (rowIndex == 4) {
+              touchKeyboardKey(controls[index]);
+            } else {
+              char key = (m_touchSymbols ? symbols : letters)[rowIndex][index];
+              if (m_touchShift && key >= 'a' && key <= 'z') key -= 'a' - 'A';
+              touchKeyboardKey(std::string(1, key));
+            }
+          },
+          .configure = [](Button& key) { key.setFlexGrow(1.0F); key.setMinWidth(0.0F); key.setMaxWidth(0.0F); },
+      }));
+      const auto bg = colorSpecFromRole(rowIndex == 4 ? ColorRole::Secondary : ColorRole::SurfaceVariant);
+      const auto fg = colorSpecFromRole(rowIndex == 4 ? ColorRole::OnSecondary : ColorRole::OnSurface);
+      const auto press = colorSpecFromRole(ColorRole::Primary);
+      button->setRadius(8.0F);
+      button->setCustomPalette(Button::ButtonPalette{
+          .normal = {.bg = bg, .border = bg, .label = fg},
+          .hover = {.bg = bg, .border = bg, .label = fg},
+          .pressed = {.bg = press, .border = press, .label = colorSpecFromRole(ColorRole::OnPrimary)},
+          .disabled = {.bg = bg, .border = bg, .label = fg},
+      });
+      m_touchKeyButtons.push_back(button);
+    }
+  }
+  refreshTouchKeyboard();
+}
+
+void LockSurface::refreshTouchKeyboard() {
+  const std::array<std::string, 4> letters = {
+      "1234567890", "qwertyuiop", "asdfghjkl;", "zxcvbnm,./"};
+  const std::array<std::string, 4> symbols = {
+      "!@#$%^&*()", "_+-=[]{}\\|", ":;\"'<>,.?/", "`~12345678"};
+  const std::array<std::string, 5> controls = {"Shift", "#+=", "Space", "Backspace", "Enter"};
+  for (std::size_t i = 0; i < m_touchKeyButtons.size(); ++i) {
+    if (i >= 40) {
+      const std::array<std::string, 5> labels = {"⇧", "123", " ", "⌫", "Enter"};
+      m_touchKeyButtons[i]->setText(labels[i - 40]);
+    } else {
+      char key = (m_touchSymbols ? symbols : letters)[i / 10][i % 10];
+      if (m_touchShift && key >= 'a' && key <= 'z') key -= 'a' - 'A';
+      m_touchKeyButtons[i]->setText(std::string(1, key));
+    }
+  }
+  requestUpdate();
+}
+
+void LockSurface::touchKeyboardKey(const std::string& key) {
+  if (key == "Shift") { m_touchShift = !m_touchShift; refreshTouchKeyboard(); return; }
+  if (key == "#+=") { m_touchSymbols = !m_touchSymbols; refreshTouchKeyboard(); return; }
+  // Use the same editor as physical keys, including caret position and the
+  // select-all state after a failed attempt. Direct string append lost edits.
+  std::uint32_t sym = key == "Backspace" ? 0xff08 : key == "Enter" ? 0xff0d : key == "Space" ? 32 : static_cast<unsigned char>(key[0]);
+  const std::uint32_t utf32 = sym < 128 ? sym : 0;
+  m_passwordField->inputArea()->dispatchKey(sym, utf32, 0, true);
+  m_passwordField->inputArea()->dispatchKey(sym, utf32, 0, false);
+  requestUpdate();
+}
