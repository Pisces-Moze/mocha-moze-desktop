#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -eu
case "${1:-status}" in
 status) exec /usr/local/libexec/mocha-app-freezer.py --status ;;
 off) exec systemctl --user stop mocha-app-freezer.service ;;
 on) exec systemctl --user start mocha-app-freezer.service ;;
 *) echo 'usage: mocha-memory [status|on|off]' >&2; exit 2 ;;
esac
